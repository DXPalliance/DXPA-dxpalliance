# GEMINI_API_KEY: Server-side only (never exposed to browser).
# Required for AI campaign generation, plain-English rewriting, SVG banners, and research.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# APP_URL & PORT: Local workshop defaults to http://localhost:3000
PORT=3000
APP_URL="http://localhost:3000"

# VITE_DISABLE_CLOUD_SYNC: Set to "true" on local Workshop Machine 1 to disable
# optional Google Sign-In / Cloud Firestore sync completely (100% browser localStorage).
VITE_DISABLE_CLOUD_SYNC="false"

# Optional CRM OAuth 2.0 App Credentials (leave blank during Tdex pre-ratification phase)
# Callback URL: <APP_URL>/auth/callback
# MAILCHIMP_CLIENT_ID=
# MAILCHIMP_CLIENT_SECRET=
# HUBSPOT_CLIENT_ID=
# HUBSPOT_CLIENT_SECRET=
# SALESFORCE_CLIENT_ID=
# SALESFORCE_CLIENT_SECRET=

# Optional Direct Server-Side CRM Tokens (if using Private App / Server Token mode)
# MAILCHIMP_API_KEY=
# MAILCHIMP_SERVER_PREFIX=
# HUBSPOT_ACCESS_TOKEN=
# SALESFORCE_ACCESS_TOKEN=
# SALESFORCE_INSTANCE_URL=

# Optional Scientific Connector Rate-Limit Keys (public tiers work without keys)
# NCBI_API_KEY=
# OPENALEX_API_KEY=
# FDA_API_KEY=
# USER_EMAIL=
